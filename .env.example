# Local development only. Copy to .env (which is gitignored) and fill in.
# In production the key comes from Google Secret Manager and this file is ignored.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# #248: the Google brain (✦ Google on the page): GEMINI=on and a key from Google AI Studio.
# GEMINI=on
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.8-flash          (answers)
# GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite   (picks the tool groups)
# GEMINI_LIVE=on                          (#250: with ✦ Google, the microphone talks to Gemini Live)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Charon                (optional: one of Gemini's prebuilt voices)

# Optional overrides (defaults shown); see PLAN.md for the full list.
# PORT=8080
# COST_SUBSCRIPTIONS="Claude Pro=20"   (#247: fixed monthly fees in USD for the 💲 Costs panel, comma-separated)
# CLASSIFIER_MODEL=anthropic:claude-haiku-5-5
# ANSWER_MODEL=anthropic:claude-sonnet-5-5
# PROFILE_SOURCE=file:data/profile.md
# MEMORY_STORE=sqlite        (or "memory": RAM only, lost on restart)
# MEMORY_DB=data/memory.sqlite
# Atlas's voice (pick one on http://localhost:8080/voices, then set both):
# TTS_PROVIDER=browser       (or kokoro / piper, after npm run voice:setup and voice:up)
# TTS_VOICE=
# KOKORO_URL=http://127.0.0.1:8880   (must be on this machine)
# PIPER_URL=http://127.0.0.1:5001
# Atlas's ears: whisper.cpp on this machine (npm run voice:setup and voice:up).
# WHISPER_URL=http://127.0.0.1:8178  (must be on this machine)
# The local brain (#88): Ollama on this machine. The chat page switches between Local and Claude.
# OLLAMA_URL=http://127.0.0.1:11434  (must be on this machine)
OLLAMA_MODEL=qwen3:8b
# OLLAMA_THINK=off          (on: the local model thinks before answering; slower to start talking)
# BARE_MODE=on              (every turn: only the EC precheck, then the brain with the history and a short persona)
# PROFILE=on                (with BARE_MODE=on: the brain also gets data/profile.md; still no memory or contexts)
# CALENDAR=on               (with BARE_MODE=on, local only: read your Google Calendar; first run npm run calendar:connect)
# CALENDAR_WRITE=on         (with CALENDAR=on and Claude: Claude may propose new events; only your "Add it" adds them. Connect with: CALENDAR_WRITE=on npm run calendar:connect)
# MEMORY=on                 (with BARE_MODE=on and Claude: remembers across conversations, short-term that fades and long-term that lasts; see the Memories panel)
# INTROSPECTION=on          (with MEMORY=on: every night at 03:30 Atlas reviews his short-term memory; npm run memory:reflect runs it now)
# GMAIL_WRITE=on            (with GMAIL=on: Claude drafts emails and replies; only your "Send it" sends. Reconnect: GMAIL_WRITE=on npm run gmail:connect -- <account>)
# GMAIL_ARCHIVE_CLEARS=NoisySource  (labels archiving also takes off, for the views you read mail in; archiving also marks it read)
# GMAIL_TIDY=on             (with GMAIL=on: inbox triage; archive and label only after your "Tidy it", never delete. Reconnect: GMAIL_WRITE=on GMAIL_TIDY=on npm run gmail:connect -- <account>)
# GMAIL=on                  (with BARE_MODE=on and Claude: search and read your Gmail, read-only. Connect each account: npm run gmail:connect -- personal / noisysource)
# GITHUB=on                 (with BARE_MODE=on and Claude: read your repos, issues, PRs and CI, read-only. Connect each owner: npm run github:connect -- <owner>)
# VENDUS=on                 (with BARE_MODE=on and Claude: KidClub's invoices in Vendus, read-only. Key of Atlas's own Vendus user: npm run vendus:connect)
# HOUSE=on                  (the house: with HOUSE_CONTROL=on, everything; with only GCLOUD=on, house_now read-only from HOUSE_ENV)
# HOUSE_CONTROL=on          (with HOUSE=on: the whole house as Atlas's domotics user, every change after your OK; npm run house:connect first)
# HOUSE_ENV=nsprod          (only for the read-only path without HOUSE_CONTROL)
# GCLOUD=on                 (with BARE_MODE=on and Claude: read errors and logs in your Google Cloud environments, read-only. Connect each: npm run gcloud:connect -- dev <project-id>)
# WEB_SEARCH=on             (with Claude: look things up online, Anthropic's web search, $10 per 1,000 searches; at most WEB_SEARCH_PER_QUESTION=3 per answer and WEB_SEARCH_PER_DAY=40 a day, counted in code)
# WEB_SEARCH_COUNTRY=PT     (and WEB_SEARCH_CITY=Coimbra, optional: where results should be local to)
# TOOL_ROUTER=model         (which tools Claude gets per question: model = words + last answers + a one-word pick by Haiku; rules = without Haiku; all = every tool every time)
# BRIEF_AT=07:30            (#177: when the morning brief is prepared each day, your time; it shows as a card on the page. BRIEF_SCHEDULE=off to turn it off)
# CODE_AGENT_MODEL=claude-sonnet-5-5   (the code agent's model; without it Claude Code used the plan's most expensive default)
# CODE_REFRESH=check        (#128: nightly check of what changed since each code study; "study" also re-studies up to CODE_REFRESH_MAX=2 stale apps a night; "off")
# CODE_TASKS=on             (#191, with CODE_AGENT=on: Atlas manages coding tasks; Claude Code works on copies in data/tasks with the repo's own setup and can run tests. Your OK to start, push and close. CODE_TASK_MAX_USD=3, CODE_TASK_MAX_TURNS=80 per turn)
# CODE_FIX=on               (with CODE_AGENT=on: Atlas proposes fixes; your OK prepares one, you see the diff, your second OK opens a draft pull request. Token: npm run github:connect -- <owner> --write. CODE_FIX_MAX_USD=2, CODE_FIX_MAX_TURNS=60)
# CODE_AGENT=on             (with GITHUB=on: Claude can ask Claude Code about a repo's code, read-only, on a local copy in data/repos/)
# CODE_AGENT_MAX_USD=0.50   (cost limit per code question, 0.05 to 5)
# CODE_AGENT_MAX_TURNS=25   (step limit per code question, 3 to 60)
# CODE_STUDY_MAX_USD=5      (ceiling for studying one repo or app, 0.5 to 50)
# CODE_STUDY_MAX_TURNS=150  (step ceiling for one study, 10 to 400)
# CODE_AGENT_AUTH=auto      (auto: your Claude plan if Claude Code is signed in on this Mac, else the API key; or subscription / api-key)
# TOOL_CALLING=on           (with Claude: Claude decides when to read the calendar, code checks each call; off: code decides)
# GOOGLE_OAUTH_CLIENT_PATH=data/google-oauth-client.json   (keep both under data/: they're gitignored there)
# GOOGLE_TOKENS_PATH=data/google-tokens.json
# ATLAS_USER_NAME=          (your name for that persona; this file's copy, .env, is gitignored)
# WHISPER_HINTS_PATH=data/whisper-hints.txt   (names Whisper should expect; gitignored)
# Spoken conversation:
# VOICE_END_OF_TURN_MS=500   (silence that ends your turn, 200–3000)
# BARGE_IN_CHROME=strict     (vad: just talk to interrupt; strict: clearer speech needed; push: tap Interrupt / Space)
# BARGE_IN_SAFARI=strict
# BARGE_IN_OTHER=vad
# Latency (#76):
# VOICE_THINKING=off         (spoken answers without thinking first: the first words come much sooner; on = as typed)
# CLASSIFIER_THINKING=off    (picking a context without thinking)
# STICKY_CONTEXT=off         (on: spoken follow-ups skip the classifier; see the README before turning it on)
# SPECULATIVE_ANSWER=off     (on: the personal answer starts while the classifier runs; see the README before turning it on)
# VOICE_FIRST_CHUNK_CHARS=60 (a long first sentence is spoken from its first clause once it's this long)
# VOICE_MAX_SENTENCES=2     (bare mode, spoken: sentences after the opening reaction, unless they ask for detail)
# VOICE_PUNCTUATION_STYLE=off (bare mode, spoken: on lets replies use ... and — for pauses; an experiment)
# KOKORO_DEVICE=mps          (for npm run voice:up: mps = the M1 GPU, or cpu)
# ASK_SMALL=on              (#269: ask with a card even for small, undoable changes: own-calendar events with no guests, lights, blinds, a thermostat)
# PROACTIVE=on               (#270: Atlas speaks up on his own: house faults, time to leave, email that needs you, calendar clashes and changes)
# PROACTIVE_FROM=Coimbra, Portugal   (where you leave from, for "time to leave"; empty: told 10 minutes before)
# PROACTIVE_QUIET=22:30-08:00        (shown, not spoken)
